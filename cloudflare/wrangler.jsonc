{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fashion-centre",
  "main": "src/index.js",
  "compatibility_date": "2026-11-20",
  "assets": {"directory":"../dist","binding":"ASSETS","run_worker_first":["/api/*"],"not_found_handling":"single-page-application"},
  "d1_databases": [{"binding":"DB","database_name":"fashion-centre","database_id":"2fc8e73b-e6f1-40fb-a039-ce4dd88271bf","migrations_dir":"migrations"}],
  "r2_buckets": [{"binding":"PHOTOS","bucket_name":"fashion-centre-private-photos"}],
  "images": {"binding":"IMAGES"},
  "triggers": {"crons":["17 * * * *"]}
}
