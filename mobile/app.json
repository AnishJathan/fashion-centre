{
  "expo": {
    "name": "Fashion Centre",
    "slug": "fashion-centre",
    "scheme": "fashioncentre",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
      {
        "CFBundleURLSchemes": ["com.googleusercontent.apps.150441056689-ddj0ho1g5gbqp3tb2flhpcg9frror2pg"]
    }]
      },
      "bundleIdentifier": "com.fashioncentre.app",
      "usesAppleSignIn": true 

    },
    "android": {
      "predictiveBackGestureEnabled": true,
      "package": "com.fashioncentre.app",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },

    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo for your private Fashion Centre preview or account photo.",
          "cameraPermission": "Take a full-body photo for Fashion Centre. You choose whether to upload it.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Fashion Centre checks your pose and photo quality on this device before you choose whether to upload.",
          "recordAudioAndroid": false
        }
      ],
 
      "expo-apple-authentication"

    ],
    "platforms": [
      "ios",
      "android"
    ],
    "extra": {
      "eas": {
        "projectId": "750ea94d-0342-421c-ade4-2e3b95a1a227"
      }
    }
  }
}
