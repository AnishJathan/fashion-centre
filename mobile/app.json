{
  "expo": {
    "name": "Fashion Centre",
    "slug": "fashion-centre",
    "scheme": "fashioncentre",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.fashioncentre.preview",
      "icon": {
        "light": "./assets/identity/app-icon.png",
        "dark": "./assets/identity/app-icon-dark.png",
        "tinted": "./assets/identity/app-icon-tinted.png"
      }
    },
    "android": {
      "predictiveBackGestureEnabled": true,
      "package": "com.fashioncentre.preview",
      "adaptiveIcon": {
        "foregroundImage": "./assets/identity/adaptive-foreground.png",
        "monochromeImage": "./assets/identity/adaptive-foreground.png",
        "backgroundColor": "#934124"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": "Take a full-body photo for Fashion Centre. You choose whether to upload it.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Fashion Centre checks your pose and photo quality on this device before you choose whether to upload.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/identity/app-icon.png"
  }
}
